# Neon Auth URL - get this from your Neon project dashboard
# Format: https://<project-id>.neonauth.<region>.aws.neon.tech/<database>/auth
NEON_AUTH_URL=https://ep-xxxxx.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth

# Neon Data API URL
DATABASE_URL=https://ep-xxxxx.apirest.c-3.us-east-1.aws.neon.tech/neondb/rest/v1

# Database schema (optional, defaults to 'public')
DATABASE_SCHEMA=public
